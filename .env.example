# Preparation only. Enable after DNS verification, Turnstile setup, privacy
# information and a real send/receive test. Never commit real keys.
CONTACT_ENABLED=false
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
# One plain email address in each setting, without a display name.
CONTACT_FROM=
CONTACT_TO=
CONTACT_REPLY_TO=
# Exact origins separated by commas. Set preview and production separately.
# Example: https://lauras-mebeles.vercel.app
CONTACT_ALLOWED_ORIGINS=
