{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'nav atkar\u012bbu'",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "functions": {
    "api/contact.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/api/contact/?$",
      "dest": "/api/contact"
    },
    {
      "src": "^/404\\.html$",
      "dest": "/404.html",
      "status": 404
    },
    {
      "src": "^/(en|ru|no)/404\\.html$",
      "dest": "/$1/404.html",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/en(?:/.*)?$",
      "dest": "/en/404.html",
      "status": 404
    },
    {
      "src": "^/ru(?:/.*)?$",
      "dest": "/ru/404.html",
      "status": 404
    },
    {
      "src": "^/no(?:/.*)?$",
      "dest": "/no/404.html",
      "status": 404
    },
    {
      "src": "^/.*$",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
